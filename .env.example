# ==========================================
# Xiaomi CW100 Dual CCTV Configuration Template
# ==========================================

# IP address kamera CCTV di jaringan lokal LAN
CCTV_CAMERA_IP=192.168.1.100
CCTV_CAMERA_PORT=54321

# Device Token (32-karakter hex didapat dari Xiaomi Cloud Tokens Extractor)
CCTV_TOKEN_HEX=your_32_character_hex_token_here

# Device ID (did)
CCTV_DID=your_device_id_here

# Port Web Dashboard CCTV
CCTV_PORT=8088

# Endpoint API go2rtc streaming gateway
GO2RTC_API=http://127.0.0.1:1984

# Endpoint RTSP untuk DVR recorder engine
RTSP_HOST=127.0.0.1:8554

# Folder penyimpanan rekaman video (default: ./recordings)
CCTV_STORAGE_DIR=./recordings

# Kredensial Akun Xiaomi (Opsional untuk status session di UI)
XIAOMI_USER_ID=your_xiaomi_user_id
XIAOMI_USER_EMAIL=your_email@example.com
CCTV_NAME=Xiaomi CW100 Dual
